MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

PASSWORD_PEPPER="your_password_pepper_secret"
JWT_SECRET="your_jwt_secret"
COMPANY_BOOTSTRAP_CODE="one_time_company_setup_code"
INVITATION_TOKEN_SECRET="dedicated_invitation_token_secret"

REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=your_redis_password

EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USER=your_ses_smtp_username
EMAIL_PASSWORD="your_ses_smtp_password"
EMAIL_USER_V2="your_sender_email@example.com"

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_S3_BUCKET="your_s3_bucket_name"

NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

CRON_SECRET="your_cron_secret"
CRON_TARGET_URL="https://yourdomain.com"
